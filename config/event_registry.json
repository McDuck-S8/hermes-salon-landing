    "no_user_interaction": {
      "name": "Нет взаимодействия",
      "triggers": ["no_user_interaction", "нет взаимодействия"],
      "agents": ["waiter"],
      "actions": ["wait_for_user"]
    }
  },

  "unknown_event": {
    "name": "Неизвестное событие",
    "agents": ["investigator"],
    "actions": ["log_unknown", "analyze_context", "classify_manual", "add_to_registry"]
  }
}
