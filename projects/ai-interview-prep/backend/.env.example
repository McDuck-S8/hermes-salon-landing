# AI Interview Prep — Backend Environment Variables
# Скопируй в .env и заполни

# OpenAI API Key (для GPT-4o мэтчинга — ОПЦИОНАЛЬНО, работает fallback без LLM)
OPENAI_API_KEY=sk-your-openai-key-here

# Модель для мэтчинга
LLM_MODEL=gpt-4o

# Базовый URL (можно сменить на OpenRouter: https://openrouter.ai/api/v1, или Groq, или локальный Ollama)
OPENAI_BASE_URL=https://api.openai.com/v1

# Настройки сервера
APP_HOST=0.0.0.0
APP_PORT=8000

# CORS (для продакшна ограничь конкретными доменами)
CORS_ORIGINS=*