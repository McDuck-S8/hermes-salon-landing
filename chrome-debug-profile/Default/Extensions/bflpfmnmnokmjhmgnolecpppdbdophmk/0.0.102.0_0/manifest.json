{
   "action": {
      "default_icon": {
         "128": "icon/128.png",
         "16": "icon/16.png",
         "32": "icon/32.png",
         "48": "icon/48.png"
      },
      "default_title": "Ask BrowserOS"
   },
   "background": {
      "service_worker": "background.js"
   },
   "chrome_url_overrides": {
      "newtab": "app.html"
   },
   "content_scripts": [ {
      "js": [ "content-scripts/auth.js" ],
      "matches": [ "https://api.browseros.com/home" ],
      "run_at": "document_start"
   }, {
      "js": [ "content-scripts/content.js" ],
      "matches": [ "*://*.google.com/*" ]
   }, {
      "js": [ "content-scripts/glow.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_start"
   }, {
      "js": [ "content-scripts/selection.js" ],
      "matches": [ "*://*/*" ],
      "run_at": "document_idle"
   } ],
   "description": "manifest.json description",
   "externally_connectable": {
      "matches": [ "https://api.browseros.com/*", "https://*.api.browseros.com/*" ]
   },
   "host_permissions": [ "http://127.0.0.1/*", "https://suggestqueries.google.com/*", "https://api.bing.com/*", "https://in.search.yahoo.com/*", "https://duckduckgo.com/*", "https://search.brave.com/*" ],
   "icons": {
      "128": "icon/128.png",
      "16": "icon/16.png",
      "32": "icon/32.png",
      "48": "icon/48.png",
      "96": "icon/96.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Assistant",
   "options_ui": {
      "open_in_tab": true,
      "page": "app.html#/settings"
   },
   "permissions": [ "topSites", "storage", "unlimitedStorage", "scripting", "tabs", "tabGroups", "sidePanel", "bookmarks", "history", "browserOS", "alarms", "webNavigation", "downloads" ],
   "side_panel": {
      "default_path": "sidepanel.html"
   },
   "update_url": "https://cdn.browseros.com/extensions/update-manifest.xml",
   "version": "0.0.102.0",
   "web_accessible_resources": [ {
      "extension_ids": [ "djhdjhlnljbjgejbndockeedocneiaei" ],
      "matches": [ "https://browseros.com/*", "https://*.browseros.com/*" ],
      "resources": [ "app.html" ]
   } ]
}
